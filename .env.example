# =============================================================
#  Peluquería Mayka · Los Alcázares (Murcia)
#  Copia este archivo como ".env" y rellena los valores.
# =============================================================

# ---- Servidor ----
PORT=3000
HOST=0.0.0.0
TZ=Europe/Madrid

# ---- Correo donde llegan las citas ----
SHOP_EMAIL=miguelmelladoros6@gmail.com

# Envío de correo:
#   smtp       = sólo SMTP (recomendado, entrega inmediata)
#   formsubmit = sólo FormSubmit.co (sin configuración)
#   auto       = SMTP si está configurado; si falla, FormSubmit
#   off        = no enviar correo (sólo guardar las citas)
MAIL_MODE=auto

# Envía también copia del correo de confirmación al cliente
MAIL_CLIENT_COPY=true

# ---- SMTP (Gmail) ----
# Para Gmail necesitas una "contraseña de aplicación":
#   Cuenta de Google > Seguridad > Verificación en 2 pasos > Contraseñas de aplicación
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=miguelmelladoros6@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx

# Remitente visible. Si lo dejas vacío se usa SMTP_USER.
MAIL_FROM=Peluquería Mayka <miguelmelladoros6@gmail.com>

# ---- Panel de gestión de citas ----
# Accede a http://localhost:3000/admin con este token.
# Cámbialo por algo más largo antes de publicar la web.
ADMIN_TOKEN=mayka-2026

# ---- Reglas de reserva ----
# Número de peluqueras que pueden atender a la vez (Mayka y Sara)
CAPACITY=2
# Paso de la rejilla de horas, en minutos
SLOT_STEP=30
# Días hacia adelante que se pueden reservar
HORIZON_DAYS=60
